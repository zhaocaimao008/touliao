{
  "name": "touliao-web",
  "version": "8.0.0",
  "description": "投聊 — 企业级安全即时通讯客户端",
  "homepage": "",
  "author": {
    "name": "投聊",
    "email": ""
  },
  "desktopName": "com.touliao.desktop",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "dev:mobile": "ionic serve",
    "build:mobile": "npm run build && cap sync",
    "build:android": "npm run build && cap add android && cap sync android && cap open android",
    "build:ios": "npm run build && cap add ios && cap sync ios && cap open ios",
    "android:build": "cd android && ./gradlew assembleRelease",
    "ios:build": "cd ios && xcodebuild -workspace touliao.xcworkspace -scheme touliao -configuration Release",
    "android:run": "cd android && ./gradlew assembleDebug && adb install -r app/build/outputs/apk/debug/app-debug.apk",
    "ios:run": "cd ios && xcodebuild -workspace touliao.xcworkspace -scheme touliao",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "check:capacitor": "node scripts/check-capacitor-versions.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@sentry/tracing": "^7.120.4",
    "axios": "^1.6.7",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.0.6",
    "esbuild": "^0.28.1",
    "jsqr": "1.4.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.11",
    "socket.io-client": "^4.7.4",
    "timeago.js": "^4.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^4.8.2",
    "@capacitor/cli": "^4.8.2",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "vite": "^8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9",
    "wait-on": "^9.0.10",
    "workbox-webpack-plugin": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "optionalDependencies": {
    "@capacitor/app": "^4.0.0",
    "@capacitor/camera": "^4.0.0",
    "@capacitor/core": "^4.0.0",
    "@capacitor/filesystem": "^4.0.0",
    "@capacitor/geolocation": "^4.0.0",
    "@capacitor/network": "^4.0.0",
    "@capacitor/push-notifications": "^4.0.0"
  }
}
