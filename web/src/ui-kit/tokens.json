{
  "meta": {
    "name": "投聊 UI Design Tokens",
    "version": "1.0.0",
    "status": "proposed-design-standard",
    "description": "用于 Web、Windows、iOS、Android 的拟定视觉规范；尚未映射到现有项目技术栈。除 duration 为毫秒、opacity 为比例外，尺寸单位为逻辑像素。"
  },
  "color": {
    "light": {
      "primary": "#2864f0",
      "primaryHover": "#1d52d5",
      "primaryActive": "#1745b4",
      "primaryForeground": "#ffffff",
      "primarySoft": "#edf3ff",
      "background": "#f4f6fa",
      "surface": "#ffffff",
      "surfaceSecondary": "#f8f9fc",
      "surfaceHover": "#f0f3f8",
      "text": "#17212e",
      "textMuted": "#687587",
      "textDisabled": "#9aa5b4",
      "border": "#e7ebf2",
      "borderStrong": "#a9b5c6",
      "danger": "#dc4454",
      "dangerSoft": "#fff0f2",
      "success": "#18856b",
      "successSoft": "#e8f6f1",
      "warning": "#a7680c",
      "warningSoft": "#fff6e5",
      "overlay": "rgba(16, 21, 30, 0.42)",
      "focus": "#2864f0",
      "messageIncoming": "#ffffff",
      "messageOutgoing": "#2864f0",
      "messageOutgoingText": "#ffffff"
    },
    "dark": {
      "primary": "#7ca7ff",
      "primaryHover": "#9abcff",
      "primaryActive": "#6595f5",
      "primaryForeground": "#10151e",
      "primarySoft": "#223550",
      "background": "#10151e",
      "surface": "#18212d",
      "surfaceSecondary": "#202b3a",
      "surfaceHover": "#273547",
      "text": "#eaf0f8",
      "textMuted": "#a7b4c6",
      "textDisabled": "#6c7b90",
      "border": "#2d3a4c",
      "borderStrong": "#657892",
      "danger": "#ff8492",
      "dangerSoft": "#422933",
      "success": "#67ccb3",
      "successSoft": "#173b35",
      "warning": "#f2bf66",
      "warningSoft": "#403624",
      "overlay": "rgba(0, 0, 0, 0.60)",
      "focus": "#9abcff",
      "messageIncoming": "#202b3a",
      "messageOutgoing": "#2e58a2",
      "messageOutgoingText": "#ffffff"
    }
  },
  "typography": {
    "fontFamily": {
      "web": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif",
      "windows": "'Segoe UI', 'Microsoft YaHei', sans-serif",
      "ios": "-apple-system, 'PingFang SC', sans-serif",
      "android": "Roboto, 'Noto Sans SC', sans-serif"
    },
    "size": {"caption": 12, "bodyDesktop": 14, "bodyMobile": 16, "section": 18, "page": 22, "display": 28},
    "weight": {"regular": 400, "medium": 500, "semibold": 600, "bold": 700},
    "lineHeight": {"body": 1.6, "label": 1.4, "heading": 1.3},
    "fontScaling": {"minimumScale": 1, "verificationScale": 2}
  },
  "spacing": {"0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48},
  "radius": {"small": 8, "control": 12, "card": 12, "bubble": 16, "dialog": 20, "pill": 999},
  "borderWidth": {"default": 1, "focus": 2},
  "focus": {"width": 2, "offset": 2},
  "elevation": {
    "light": {"card": "0 2px 8px rgba(23,33,46,.04)", "popover": "0 12px 32px rgba(23,33,46,.12)", "dialog": "0 24px 72px rgba(23,33,46,.20)"},
    "dark": {"card": "0 2px 8px rgba(0,0,0,.10)", "popover": "0 12px 32px rgba(0,0,0,.28)", "dialog": "0 24px 72px rgba(0,0,0,.40)"}
  },
  "motion": {
    "duration": {"instant": 0, "fast": 120, "normal": 180, "slow": 240},
    "easing": {"standard": "cubic-bezier(0.2, 0, 0, 1)", "entrance": "cubic-bezier(0, 0, 0.2, 1)", "exit": "cubic-bezier(0.4, 0, 1, 1)"},
    "reducedMotion": {"duration": 0, "disableParallax": true, "disableAutoplayDecoration": true}
  },
  "layout": {
    "desktop": {"navigationRail": 76, "conversationList": 300, "conversationListMinimum": 260, "detailsDrawer": 300, "chatMinimum": 360, "pagePadding": 24, "headerHeight": 64},
    "mobile": {"pagePadding": 16, "headerContentHeight": 52, "bottomNavigationContentHeight": 56, "bubbleMaxWidthPercent": 82, "safeArea": "use-runtime-insets"},
    "breakpoints": {"mobileMax": 767, "compactDesktopMin": 768, "desktopMin": 1100, "expandedDesktopMin": 1400},
    "zIndex": {"base": 0, "sticky": 10, "drawer": 30, "popover": 40, "modalBackdrop": 50, "modal": 60, "toast": 70}
  },
  "platforms": {
    "web": {"bodyFontSize": 14, "iconButtonMinimum": 36, "defaultButtonHeight": 36, "inputHeight": 40, "keyboardNavigation": true, "browserZoom": true},
    "windows": {"bodyFontSize": 14, "iconButtonMinimum": 36, "defaultButtonHeight": 36, "inputHeight": 40, "nativeTitleBarPreferred": true, "resizeMinimumWidth": 760, "resizeMinimumHeight": 560},
    "ios": {"bodyFontSize": 16, "touchTargetMinimum": 44, "defaultButtonHeight": 48, "inputHeight": 48, "dynamicType": true, "useSafeArea": true},
    "android": {"bodyFontSize": 16, "touchTargetMinimum": 48, "defaultButtonHeight": 48, "inputHeight": 48, "fontScale": true, "useSystemInsets": true}
  },
  "components": {
    "button": {"radius": 8, "gap": 8, "paddingInline": 16, "smallHeight": 32, "defaultDesktopHeight": 36, "defaultMobileHeight": 48, "loadingKeepsWidth": true},
    "input": {"radius": 12, "paddingInline": 12, "labelGap": 8, "helperGap": 4},
    "avatar": {"tiny": 24, "small": 32, "default": 44, "large": 64, "profile": 88, "radius": 12},
    "icon": {"small": 16, "default": 20, "navigation": 24, "strokeWidth": 1.8},
    "listRow": {"desktopMinimum": 68, "mobileMinimum": 76, "gap": 12},
    "message": {"radius": 16, "paddingInline": 12, "paddingBlock": 8, "groupGap": 4, "authorGap": 16, "desktopMaxWidth": 560, "mobileMaxWidthPercent": 82},
    "dialog": {"radius": 20, "desktopWidth": 440, "desktopMaxWidth": 640, "padding": 24, "actionGap": 8},
    "toast": {"duration": 4000, "actionDuration": 8000, "maxVisible": 2},
    "skeleton": {"animationDuration": 1200, "reducedMotionAnimation": false}
  },
  "semantics": {
    "connection": ["online", "connecting", "offline", "reconnecting", "failed"],
    "messageDelivery": ["draft", "preparing", "uploading", "sending", "sent", "failed"],
    "optionalProtocolStates": ["delivered", "read", "recalled", "edited"],
    "controlStates": ["default", "hover", "pressed", "focus-visible", "disabled", "loading", "selected"],
    "pageStates": ["ready", "loading", "empty", "error", "offline", "permission-denied"]
  }
}
