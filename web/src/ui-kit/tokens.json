{
  "meta": {
    "name": "投聊 UI Design Tokens",
    "version": "1.2.0",
    "status": "implemented-with-platform-adapters",
    "description": "投聊四端已落地的语义规范源。布局数值为逻辑 px，原生映射到 pt/dp；字体映射到 Dynamic Type/sp；duration 为 ms。平台适配值保留已验证布局，详见 docs/design-system/TOKEN-CONTRACT.md。 v3 极光色板：月白 #F7F8FC / 墨 #171A26 / 细线 #E4E7F0 / 渊空 #0B0E1A，新增 auroraTeal #5EEAD4。",
    "owner": "Touliao client UI maintainers"
  },
  "color": {
    "light": {
      "primary": "#5B4CF0",
      "primaryHover": "#4E3FE3",
      "primaryActive": "#4233CC",
      "primaryForeground": "#ffffff",
      "primarySoft": "#EEEBFF",
      "background": "#F2F2F7",
      "surface": "#ffffff",
      "surfaceSecondary": "#F7F7FA",
      "surfaceHover": "#ECECF2",
      "text": "#0B0B12",
      "textMuted": "#636373",
      "textDisabled": "#A1A1AE",
      "border": "#E3E3EA",
      "borderStrong": "#BDBDC9",
      "danger": "#D7263D",
      "dangerSoft": "#FFEEF0",
      "success": "#11795F",
      "successSoft": "#E6F6F0",
      "warning": "#9A5B00",
      "warningSoft": "#FFF4E0",
      "overlay": "rgba(10, 10, 20, 0.40)",
      "focus": "#5B4CF0",
      "auroraTeal": "#5EEAD4",
      "messageIncoming": "#E9E9F0",
      "messageOutgoing": "#5B4CF0",
      "messageOutgoingText": "#ffffff",
      "iconOnDark": "#ffffff",
      "iconOnLight": "#0B0B12",
      "primaryText": "#5B4CF0"
    },
    "dark": {
      "primary": "#6A5BF7",
      "primaryHover": "#7A6CFA",
      "primaryActive": "#5B4CF0",
      "primaryForeground": "#ffffff",
      "primarySoft": "#231F48",
      "background": "#000000",
      "surface": "#1C1C1E",
      "surfaceSecondary": "#2C2C2E",
      "surfaceHover": "#3A3A3C",
      "text": "#F5F5F7",
      "textMuted": "#A1A1AB",
      "textDisabled": "#6E6E78",
      "border": "#2C2C2E",
      "borderStrong": "#48484A",
      "danger": "#FF6B7D",
      "dangerSoft": "#3A1D23",
      "success": "#4FD1A5",
      "successSoft": "#12332A",
      "warning": "#FFC45C",
      "warningSoft": "#3A2E17",
      "overlay": "rgba(0, 0, 0, 0.62)",
      "focus": "#9B90FF",
      "auroraTeal": "#5EEAD4",
      "messageIncoming": "#2C2C2E",
      "messageOutgoing": "#6A5BF7",
      "messageOutgoingText": "#ffffff",
      "iconOnDark": "#ffffff",
      "iconOnLight": "#17212e",
      "primaryText": "#A99FFF"
    }
  },
  "typography": {
    "fontFamily": {
      "web": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif",
      "windows": "'Segoe UI', 'Microsoft YaHei', sans-serif",
      "ios": "-apple-system, 'PingFang SC', sans-serif",
      "android": "Roboto, 'Noto Sans SC', sans-serif"
    },
    "size": {
      "caption": 12,
      "bodyDesktop": 14,
      "bodyMobile": 16,
      "section": 18,
      "page": 22,
      "display": 28
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "body": 1.6,
      "label": 1.4,
      "heading": 1.3
    },
    "fontScaling": {
      "minimumScale": 1,
      "verificationScale": 2
    },
    "roles": {
      "display": {
        "size": "display",
        "weight": "semibold",
        "lineHeight": "heading",
        "iosStyle": "largeTitle"
      },
      "title": {
        "size": "page",
        "weight": "semibold",
        "lineHeight": "heading",
        "iosStyle": "title2"
      },
      "headline": {
        "size": "section",
        "weight": "medium",
        "lineHeight": "heading",
        "iosStyle": "headline"
      },
      "body": {
        "size": "bodyMobile",
        "desktopSize": "bodyDesktop",
        "weight": "regular",
        "lineHeight": "body",
        "iosStyle": "body"
      },
      "secondary": {
        "size": "bodyDesktop",
        "weight": "regular",
        "lineHeight": "body",
        "iosStyle": "subheadline"
      },
      "caption": {
        "size": "caption",
        "weight": "regular",
        "lineHeight": "label",
        "iosStyle": "caption"
      }
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radius": {
    "small": 10,
    "control": 14,
    "card": 20,
    "bubble": 20,
    "dialog": 28,
    "pill": 999
  },
  "borderWidth": {
    "default": 1,
    "focus": 2
  },
  "focus": {
    "width": 2,
    "offset": 2
  },
  "elevation": {
    "light": {
      "card": "0 1px 2px rgba(10,10,20,.04), 0 4px 16px rgba(10,10,20,.04)",
      "popover": "0 16px 40px rgba(10,10,20,.14)",
      "dialog": "0 32px 80px rgba(10,10,20,.22)"
    },
    "dark": {
      "card": "0 2px 8px rgba(0,0,0,.10)",
      "popover": "0 12px 32px rgba(0,0,0,.28)",
      "dialog": "0 24px 72px rgba(0,0,0,.40)"
    }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 120,
      "normal": 180,
      "slow": 240
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "entrance": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reducedMotion": {
      "duration": 0,
      "disableParallax": true,
      "disableAutoplayDecoration": true
    }
  },
  "layout": {
    "desktop": {
      "navigationRail": 76,
      "conversationList": 300,
      "conversationListMinimum": 260,
      "detailsDrawer": 300,
      "chatMinimum": 360,
      "pagePadding": 24,
      "headerHeight": 64
    },
    "mobile": {
      "pagePadding": 16,
      "headerContentHeight": 52,
      "bottomNavigationContentHeight": 56,
      "bubbleMaxWidthPercent": 82,
      "safeArea": "use-runtime-insets"
    },
    "breakpoints": {
      "mobileMax": 767,
      "compactDesktopMin": 768,
      "desktopMin": 1100,
      "expandedDesktopMin": 1400
    },
    "zIndex": {
      "base": 0,
      "raised": 1,
      "local": 10,
      "page": 60,
      "sticky": 100,
      "dropdown": 200,
      "panel": 300,
      "modal": 1000,
      "popover": 1100,
      "toast": 1200,
      "tooltip": 1300,
      "call": 2000,
      "callTop": 3000,
      "top": 9999,
      "native": 100000
    }
  },
  "platforms": {
    "web": {
      "bodyFontSize": 14,
      "iconButtonMinimum": 36,
      "defaultButtonHeight": 40,
      "inputHeight": 40,
      "keyboardNavigation": true,
      "browserZoom": true,
      "settingsRowMinimum": 64
    },
    "windows": {
      "bodyFontSize": 14,
      "iconButtonMinimum": 36,
      "defaultButtonHeight": 40,
      "inputHeight": 40,
      "nativeTitleBarPreferred": true,
      "resizeMinimumWidth": 760,
      "resizeMinimumHeight": 560,
      "settingsRowMinimum": 64
    },
    "ios": {
      "bodyFontSize": 16,
      "touchTargetMinimum": 44,
      "defaultButtonHeight": 48,
      "inputHeight": 48,
      "dynamicType": true,
      "useSafeArea": true,
      "settingsRowMinimum": 57
    },
    "android": {
      "bodyFontSize": 16,
      "touchTargetMinimum": 48,
      "defaultButtonHeight": 48,
      "inputHeight": 48,
      "fontScale": true,
      "useSystemInsets": true,
      "settingsRowMinimum": 56
    }
  },
  "components": {
    "button": {
      "radius": 12,
      "gap": 8,
      "paddingInline": 16,
      "smallHeight": 32,
      "defaultDesktopHeight": 40,
      "defaultMobileHeight": 48,
      "loadingKeepsWidth": true
    },
    "input": {
      "radius": 12,
      "paddingInline": 12,
      "labelGap": 8,
      "helperGap": 4
    },
    "avatar": {
      "radius": 12,
      "sizes": {
        "micro": 24,
        "xs": 28,
        "sm": 36,
        "md": 40,
        "lg": 48,
        "xl": 64,
        "hero": 92,
        "call": 88
      },
      "roles": {
        "metadata": "xs",
        "message": "sm",
        "list": "md",
        "request": "lg",
        "profile": "xl",
        "hero": "hero",
        "call": "call"
      },
      "nativeRoles": {
        "metadata": 28,
        "message": 36,
        "list": 44,
        "request": 48,
        "profile": 64,
        "hero": 66,
        "call": 96
      }
    },
    "icon": {
      "small": 16,
      "default": 20,
      "navigation": 24,
      "strokeWidth": 1.8,
      "sizes": {
        "xs": 16,
        "sm": 20,
        "md": 24,
        "lg": 32,
        "xl": 40
      },
      "roles": {
        "default": "sm",
        "small": "xs",
        "navigation": "md",
        "tab": "md",
        "toolbar": "md",
        "chatAction": "md",
        "call": "md",
        "empty": "xl"
      }
    },
    "listRow": {
      "desktopMinimum": 68,
      "mobileMinimum": 76,
      "gap": 12
    },
    "message": {
      "radius": 16,
      "paddingInline": 12,
      "paddingBlock": 8,
      "groupGap": 4,
      "authorGap": 16,
      "desktopMaxWidth": 560,
      "mobileMaxWidthPercent": 82
    },
    "dialog": {
      "radius": 20,
      "desktopWidth": 420,
      "desktopMaxWidth": 640,
      "padding": 24,
      "actionGap": 8
    },
    "toast": {
      "duration": 4000,
      "actionDuration": 8000,
      "maxVisible": 1,
      "errorDuration": 4500,
      "readMillisPerCharacter": 80,
      "maximumDuration": 12000
    },
    "skeleton": {
      "animationDuration": 1200,
      "reducedMotionAnimation": false
    },
    "control": {
      "touchTarget": 44,
      "disabledOpacity": 0.55,
      "borderWidth": 1,
      "mobileSettingsRowMinimum": 68
    },
    "media": {
      "canvas": "#10151e",
      "surface": "#18212d",
      "text": "#eaf0f8",
      "secondary": "#c4d0e0",
      "control": "#2d3a4c",
      "selected": "#416bb4",
      "danger": "#be3f4e",
      "accept": "#18856b",
      "controlSize": 56,
      "primaryControlSize": 68,
      "controlGap": 16,
      "endedDuration": 1800,
      "nativeControlSize": 64
    }
  },
  "semantics": {
    "connection": [
      "online",
      "connecting",
      "offline",
      "reconnecting",
      "failed"
    ],
    "messageDelivery": [
      "draft",
      "preparing",
      "uploading",
      "sending",
      "sent",
      "failed"
    ],
    "optionalProtocolStates": [
      "delivered",
      "read",
      "recalled",
      "edited"
    ],
    "controlStates": [
      "default",
      "hover",
      "pressed",
      "focus-visible",
      "disabled",
      "loading",
      "selected"
    ],
    "pageStates": [
      "ready",
      "loading",
      "empty",
      "error",
      "offline",
      "permission-denied"
    ]
  }
}
