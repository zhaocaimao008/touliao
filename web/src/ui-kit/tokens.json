{
  "meta": {
    "name": "投聊 UI Design Tokens",
    "version": "1.1.0",
    "status": "implemented-with-platform-adapters",
    "description": "投聊四端已落地的语义规范源。布局数值为逻辑 px，原生映射到 pt/dp；字体映射到 Dynamic Type/sp；duration 为 ms。平台适配值保留已验证布局，详见 docs/design-system/TOKEN-CONTRACT.md。",
    "owner": "Touliao client UI maintainers"
  },
  "color": {
    "light": {
      "primary": "#2864f0",
      "primaryHover": "#1d52d5",
      "primaryActive": "#1745b4",
      "primaryForeground": "#ffffff",
      "primarySoft": "#edf3ff",
      "background": "#f4f6fa",
      "surface": "#ffffff",
      "surfaceSecondary": "#f8f9fc",
      "surfaceHover": "#f0f3f8",
      "text": "#17212e",
      "textMuted": "#687587",
      "textDisabled": "#9aa5b4",
      "border": "#e7ebf2",
      "borderStrong": "#a9b5c6",
      "danger": "#dc4454",
      "dangerSoft": "#fff0f2",
      "success": "#18856b",
      "successSoft": "#e8f6f1",
      "warning": "#a7680c",
      "warningSoft": "#fff6e5",
      "overlay": "rgba(16, 21, 30, 0.42)",
      "focus": "#2864f0",
      "messageIncoming": "#ffffff",
      "messageOutgoing": "#2864f0",
      "messageOutgoingText": "#ffffff",
      "iconOnDark": "#ffffff",
      "iconOnLight": "#17212e"
    },
    "dark": {
      "primary": "#7ca7ff",
      "primaryHover": "#9abcff",
      "primaryActive": "#6595f5",
      "primaryForeground": "#10151e",
      "primarySoft": "#223550",
      "background": "#10151e",
      "surface": "#18212d",
      "surfaceSecondary": "#202b3a",
      "surfaceHover": "#273547",
      "text": "#eaf0f8",
      "textMuted": "#a7b4c6",
      "textDisabled": "#6c7b90",
      "border": "#2d3a4c",
      "borderStrong": "#657892",
      "danger": "#ff8492",
      "dangerSoft": "#422933",
      "success": "#67ccb3",
      "successSoft": "#173b35",
      "warning": "#f2bf66",
      "warningSoft": "#403624",
      "overlay": "rgba(0, 0, 0, 0.60)",
      "focus": "#9abcff",
      "messageIncoming": "#202b3a",
      "messageOutgoing": "#2e58a2",
      "messageOutgoingText": "#ffffff",
      "iconOnDark": "#ffffff",
      "iconOnLight": "#17212e"
    }
  },
  "typography": {
    "fontFamily": {
      "web": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif",
      "windows": "'Segoe UI', 'Microsoft YaHei', sans-serif",
      "ios": "-apple-system, 'PingFang SC', sans-serif",
      "android": "Roboto, 'Noto Sans SC', sans-serif"
    },
    "size": {
      "caption": 12,
      "bodyDesktop": 14,
      "bodyMobile": 16,
      "section": 18,
      "page": 22,
      "display": 28
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "body": 1.6,
      "label": 1.4,
      "heading": 1.3
    },
    "fontScaling": {
      "minimumScale": 1,
      "verificationScale": 2
    },
    "roles": {
      "display": {
        "size": "display",
        "weight": "semibold",
        "lineHeight": "heading",
        "iosStyle": "largeTitle"
      },
      "title": {
        "size": "page",
        "weight": "semibold",
        "lineHeight": "heading",
        "iosStyle": "title2"
      },
      "headline": {
        "size": "section",
        "weight": "medium",
        "lineHeight": "heading",
        "iosStyle": "headline"
      },
      "body": {
        "size": "bodyMobile",
        "desktopSize": "bodyDesktop",
        "weight": "regular",
        "lineHeight": "body",
        "iosStyle": "body"
      },
      "secondary": {
        "size": "bodyDesktop",
        "weight": "regular",
        "lineHeight": "body",
        "iosStyle": "subheadline"
      },
      "caption": {
        "size": "caption",
        "weight": "regular",
        "lineHeight": "label",
        "iosStyle": "caption"
      }
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48
  },
  "radius": {
    "small": 8,
    "control": 12,
    "card": 12,
    "bubble": 16,
    "dialog": 20,
    "pill": 999
  },
  "borderWidth": {
    "default": 1,
    "focus": 2
  },
  "focus": {
    "width": 2,
    "offset": 2
  },
  "elevation": {
    "light": {
      "card": "0 2px 8px rgba(23,33,46,.04)",
      "popover": "0 12px 32px rgba(23,33,46,.12)",
      "dialog": "0 24px 72px rgba(23,33,46,.20)"
    },
    "dark": {
      "card": "0 2px 8px rgba(0,0,0,.10)",
      "popover": "0 12px 32px rgba(0,0,0,.28)",
      "dialog": "0 24px 72px rgba(0,0,0,.40)"
    }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 120,
      "normal": 180,
      "slow": 240
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "entrance": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reducedMotion": {
      "duration": 0,
      "disableParallax": true,
      "disableAutoplayDecoration": true
    }
  },
  "layout": {
    "desktop": {
      "navigationRail": 76,
      "conversationList": 300,
      "conversationListMinimum": 260,
      "detailsDrawer": 300,
      "chatMinimum": 360,
      "pagePadding": 24,
      "headerHeight": 64
    },
    "mobile": {
      "pagePadding": 16,
      "headerContentHeight": 52,
      "bottomNavigationContentHeight": 56,
      "bubbleMaxWidthPercent": 82,
      "safeArea": "use-runtime-insets"
    },
    "breakpoints": {
      "mobileMax": 767,
      "compactDesktopMin": 768,
      "desktopMin": 1100,
      "expandedDesktopMin": 1400
    },
    "zIndex": {
      "base": 0,
      "raised": 1,
      "local": 10,
      "page": 60,
      "sticky": 100,
      "dropdown": 200,
      "panel": 300,
      "modal": 1000,
      "popover": 1100,
      "toast": 1200,
      "tooltip": 1300,
      "call": 2000,
      "callTop": 3000,
      "top": 9999,
      "native": 100000
    }
  },
  "platforms": {
    "web": {
      "bodyFontSize": 14,
      "iconButtonMinimum": 36,
      "defaultButtonHeight": 40,
      "inputHeight": 40,
      "keyboardNavigation": true,
      "browserZoom": true,
      "settingsRowMinimum": 64
    },
    "windows": {
      "bodyFontSize": 14,
      "iconButtonMinimum": 36,
      "defaultButtonHeight": 40,
      "inputHeight": 40,
      "nativeTitleBarPreferred": true,
      "resizeMinimumWidth": 760,
      "resizeMinimumHeight": 560,
      "settingsRowMinimum": 64
    },
    "ios": {
      "bodyFontSize": 16,
      "touchTargetMinimum": 44,
      "defaultButtonHeight": 48,
      "inputHeight": 48,
      "dynamicType": true,
      "useSafeArea": true,
      "settingsRowMinimum": 57
    },
    "android": {
      "bodyFontSize": 16,
      "touchTargetMinimum": 48,
      "defaultButtonHeight": 48,
      "inputHeight": 48,
      "fontScale": true,
      "useSystemInsets": true,
      "settingsRowMinimum": 56
    }
  },
  "components": {
    "button": {
      "radius": 12,
      "gap": 8,
      "paddingInline": 16,
      "smallHeight": 32,
      "defaultDesktopHeight": 40,
      "defaultMobileHeight": 48,
      "loadingKeepsWidth": true
    },
    "input": {
      "radius": 12,
      "paddingInline": 12,
      "labelGap": 8,
      "helperGap": 4
    },
    "avatar": {
      "radius": 12,
      "sizes": {
        "micro": 24,
        "xs": 28,
        "sm": 36,
        "md": 40,
        "lg": 48,
        "xl": 64,
        "hero": 92,
        "call": 88
      },
      "roles": {
        "metadata": "xs",
        "message": "sm",
        "list": "md",
        "request": "lg",
        "profile": "xl",
        "hero": "hero",
        "call": "call"
      },
      "nativeRoles": {
        "metadata": 28,
        "message": 36,
        "list": 44,
        "request": 48,
        "profile": 64,
        "hero": 66,
        "call": 96
      }
    },
    "icon": {
      "small": 16,
      "default": 20,
      "navigation": 24,
      "strokeWidth": 1.8,
      "sizes": {
        "xs": 16,
        "sm": 20,
        "md": 24,
        "lg": 32,
        "xl": 40
      },
      "roles": {
        "default": "sm",
        "small": "xs",
        "navigation": "md",
        "tab": "md",
        "toolbar": "md",
        "chatAction": "md",
        "call": "md",
        "empty": "xl"
      }
    },
    "listRow": {
      "desktopMinimum": 68,
      "mobileMinimum": 76,
      "gap": 12
    },
    "message": {
      "radius": 16,
      "paddingInline": 12,
      "paddingBlock": 8,
      "groupGap": 4,
      "authorGap": 16,
      "desktopMaxWidth": 560,
      "mobileMaxWidthPercent": 82
    },
    "dialog": {
      "radius": 20,
      "desktopWidth": 420,
      "desktopMaxWidth": 640,
      "padding": 24,
      "actionGap": 8
    },
    "toast": {
      "duration": 4000,
      "actionDuration": 8000,
      "maxVisible": 1,
      "errorDuration": 4500,
      "readMillisPerCharacter": 80,
      "maximumDuration": 12000
    },
    "skeleton": {
      "animationDuration": 1200,
      "reducedMotionAnimation": false
    },
    "control": {
      "touchTarget": 44,
      "disabledOpacity": 0.55,
      "borderWidth": 1,
      "mobileSettingsRowMinimum": 68
    },
    "media": {
      "canvas": "#10151e",
      "surface": "#18212d",
      "text": "#eaf0f8",
      "secondary": "#c4d0e0",
      "control": "#2d3a4c",
      "selected": "#416bb4",
      "danger": "#be3f4e",
      "accept": "#18856b",
      "controlSize": 56,
      "primaryControlSize": 68,
      "controlGap": 16,
      "endedDuration": 1800,
      "nativeControlSize": 64
    }
  },
  "semantics": {
    "connection": [
      "online",
      "connecting",
      "offline",
      "reconnecting",
      "failed"
    ],
    "messageDelivery": [
      "draft",
      "preparing",
      "uploading",
      "sending",
      "sent",
      "failed"
    ],
    "optionalProtocolStates": [
      "delivered",
      "read",
      "recalled",
      "edited"
    ],
    "controlStates": [
      "default",
      "hover",
      "pressed",
      "focus-visible",
      "disabled",
      "loading",
      "selected"
    ],
    "pageStates": [
      "ready",
      "loading",
      "empty",
      "error",
      "offline",
      "permission-denied"
    ]
  }
}
