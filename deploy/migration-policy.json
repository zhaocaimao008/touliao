{
  "repository": "/home/ubuntu/gh-mirror/touliao",
  "environment": "/home/ubuntu/gh-mirror/touliao/backend-v2/.env",
  "processUser": "ubuntu",
  "processHome": "/home/ubuntu/.pm2",
  "downloads": "/var/www/downloads",
  "credentialEscrow": "/home/ubuntu/.touliao-migration/ci-credentials.age",
  "sources": [
    {"source": "/home/ubuntu/gh-mirror/touliao/backend-v2/.env", "destination": "config/backend.env"},
    {"source": "/etc/touliao-turn", "destination": "config/turn", "tree": true},
    {"source": "/etc/nginx/sites-available/touliao-cc.conf", "destination": "config/nginx/touliao-cc.conf"},
    {"source": "/etc/letsencrypt/renewal/touliao.cc.conf", "destination": "config/tls/renewal.conf"},
    {"source": "/etc/letsencrypt/live/touliao.cc/cert.pem", "destination": "config/tls/cert.pem", "dereferenceWithin": "/etc/letsencrypt/archive/touliao.cc"},
    {"source": "/etc/letsencrypt/live/touliao.cc/chain.pem", "destination": "config/tls/chain.pem", "dereferenceWithin": "/etc/letsencrypt/archive/touliao.cc"},
    {"source": "/etc/letsencrypt/live/touliao.cc/fullchain.pem", "destination": "config/tls/fullchain.pem", "dereferenceWithin": "/etc/letsencrypt/archive/touliao.cc"},
    {"source": "/etc/letsencrypt/live/touliao.cc/privkey.pem", "destination": "config/tls/privkey.pem", "dereferenceWithin": "/etc/letsencrypt/archive/touliao.cc"},
    {"source": "/etc/letsencrypt/renewal-hooks/deploy/touliao-turn-cert-sync.sh", "destination": "config/hooks/touliao-turn-cert-sync.sh"},
    {"source": "/etc/systemd/system/touliao-backup.service", "destination": "config/systemd/touliao-backup.service"},
    {"source": "/etc/systemd/system/touliao-backup.timer", "destination": "config/systemd/touliao-backup.timer"},
    {"source": "/etc/touliao-backup/recipient.txt", "destination": "config/backup/recipient.txt"},
    {"source": "/etc/touliao-backup/migration-policy.json", "destination": "config/backup/migration-policy.json"},
    {"source": "/usr/local/bin/touliao-backup", "destination": "ops/touliao-backup"},
    {"source": "/usr/local/bin/touliao-backup-export", "destination": "ops/touliao-backup-export"},
    {"source": "/usr/local/bin/touliao-turn-probe-credentials", "destination": "ops/touliao-turn-probe-credentials"},
    {"source": "/usr/local/lib/touliao", "destination": "ops/lib", "tree": true},
    {"source": "/home/ubuntu/touliao-private-backups/.github/workflows/backup.yml", "destination": "ops/private-backups/.github/workflows/backup.yml"},
    {"source": "/home/ubuntu/touliao-private-backups/ssh_known_hosts", "destination": "ops/private-backups/ssh_known_hosts"},
    {"source": "/home/ubuntu/touliao-private-backups/README.md", "destination": "ops/private-backups/README.md"},
    {"source": "/home/ubuntu/.touliao-backup-admin/ssh_key", "destination": "credentials/backup-ssh-key"},
    {"source": "/home/ubuntu/.touliao-backup-admin/ssh_key.pub", "destination": "credentials/backup-ssh-key.pub"},
    {"source": "/home/ubuntu/asc-work/AuthKey_U9F23QPW5Y.p8", "destination": "credentials/asc/AuthKey_U9F23QPW5Y.p8"},
    {"source": "/var/www/touliao-web", "destination": "public/web", "tree": true},
    {"source": "/var/www/touliao-admin", "destination": "public/admin", "tree": true},
    {"source": "/var/www/touliao-landing", "destination": "public/landing", "tree": true},
    {"source": "/var/www/touliao-runtime-config", "destination": "public/runtime-config", "tree": true}
  ]
}
