[Unit]
Description=Touliao verified database and uploads backup
After=local-fs.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
Environment=TOULIAO_ROOT=/home/ubuntu/gh-mirror/touliao
Environment=BACKUP_DIR=/var/backup/touliao
ExecStart=/usr/local/bin/touliao-backup
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
