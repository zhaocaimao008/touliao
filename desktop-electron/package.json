{
  "name": "touliao-desktop",
  "version": "8.1.17",
  "description": "投聊 桌面客户端",
  "homepage": "https://touliao.cc",
  "author": {
    "name": "Touliao Team",
    "email": "support@touliao.cc"
  },
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build:web": "cd ../web && npx vite build --mode desktop",
    "build": "npm run build:web && node scripts/run-electron-builder.js && node scripts/sign-update.js dist",
    "build:win": "npm run build:web && node scripts/run-electron-builder.js --win --x64 && node scripts/sign-update.js dist latest.yml",
    "build:mac": "npm run build:web && node scripts/run-electron-builder.js --mac --x64 && node scripts/sign-update.js dist latest-mac.yml",
    "build:linux": "npm run build:web && node scripts/run-electron-builder.js --linux --x64 && node scripts/sign-update.js dist latest-linux.yml",
    "pack": "npm run build:web && node scripts/run-electron-builder.js --dir",
    "postinstall": "electron-builder install-app-deps",
    "prebuild": "node scripts/preflight-signing.js",
    "prebuild:win": "node scripts/preflight-signing.js",
    "prebuild:mac": "node scripts/preflight-signing.js",
    "prebuild:linux": "node scripts/preflight-signing.js",
    "prepack": "node scripts/preflight-signing.js"
  },
  "build": {
    "appId": "com.touliao.desktop",
    "productName": "投聊",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      {
        "from": "../web/dist",
        "to": "web/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/afterPack.js",
    "win": {
      "executableName": "touliao",
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "touliao-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "投聊",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network;InstantMessaging"
    },
    "publish": {
      "provider": "generic",
      "url": "https://touliao.cc/downloads/updates",
      "channel": "latest"
    }
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "43.6.0",
    "electron-builder": "26.15.3"
  }
}
