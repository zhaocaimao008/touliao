{
  "appId": "com.touliao.desktop",
  "productName": "投聊",
  "directories": {
    "output": "dist",
    "buildResources": "assets"
  },
  "files": [
    "src/**/*",
    "assets/**/*",
    {
      "from": "../web/dist",
      "to": "web/dist",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      "portable"
    ],
    "icon": "assets/icon.ico",
    "artifactName": "touliao-${version}-portable.${ext}",
    "signingHashAlgorithms": [
      "sha256"
    ]
  },
  "publish": {
    "provider": "generic",
    "url": "https://touliao.cc/downloads/updates",
    "channel": "latest"
  }
}
