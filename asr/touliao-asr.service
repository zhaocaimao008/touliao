[Unit]
Description=投聊 语音转文字 ASR 服务 (faster-whisper)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/touliao/asr
Environment=ASR_HOST=127.0.0.1
Environment=ASR_PORT=18790
Environment=ASR_MODEL=base
Environment=ASR_DEVICE=cpu
Environment=ASR_COMPUTE=int8
ExecStart=/root/touliao/asr/venv/bin/python3 /root/touliao/asr/asr_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
