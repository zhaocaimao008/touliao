<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 应用内更新：允许安装 APK（同签名覆盖安装，数据保留） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 通知震动：渠道 enableVibration(true) 需此权限，否则消息通知不震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 全屏来电通知（后台/锁屏拉起来电界面）。Android 14+(34) 属受限权限：
         通话类 App 首次安装默认授予，用户可在「设置>应用>全屏通知」撤销；
         无该权限时 fullScreenIntent 降级为普通高优先级横幅通知（仍响铃，只是不自动全屏）。 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- 通话保活前台服务。Android 14+(34) 要求声明 FGS 类型对应的权限，且运行时须已持有对应能力
         （microphone → RECORD_AUDIO 已在通话流程申请；camera → CAMERA 视频通话时申请）。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- 媒体读取：Android 13+ 细分权限，12 及以下用 READ_EXTERNAL_STORAGE -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- DownloadManager 写入公共「下载」目录：Android 9(28) 及以下需要，10+ 无需 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".VxinApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Vxin">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Vxin">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCM 接收服务 -->
        <service
            android:name=".core.push.VxinMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ── 个推 GeTui（国产 ROM 推送覆盖）── -->
        <!-- SDK 内置 manifest 只声明了 GETUI_APPID，APPKEY/APPSECRET 必须自己声明，
             否则 SDK 初始化拿不到完整密钥 → 无法注册 → CID 永远为空（锁屏收不到的根因）。
             tools:replace 覆盖 SDK 的空占位值，写入 manifestPlaceholders 注入的真实值。 -->
        <meta-data android:name="GETUI_APPID"     android:value="${GETUI_APPID}"     tools:replace="android:value" />
        <meta-data android:name="GETUI_APPKEY"    android:value="${GETUI_APPKEY}" />
        <meta-data android:name="GETUI_APPSECRET" android:value="${GETUI_APPSECRET}" />
        <!-- 个推消息接收服务：收到 CID → 上报后端；透传 → 弹通知 -->
        <service
            android:name=".core.push.VxinGeTuiService"
            android:exported="false" />

        <!-- 通话保活前台服务（1对1）。type 声明 microphone|camera；实际以运行时传入的 type 起服务。 -->
        <service
            android:name=".core.call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- 应用内更新：FileProvider 为系统安装器提供 APK 文件访问 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- FCM 默认通知渠道：App 被杀死时 FCM 带 notification 块到达，系统需据此渠道展示。
             与后端 push.js 的 channelId 一致（vxin_messages_v3），也是渠道未建时的兜底。 -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="vxin_messages_v3" />
    </application>
</manifest>
