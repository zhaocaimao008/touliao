<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose 应用使用无 ActionBar 主题；具体配色在 Compose Theme 中定义 -->
    <style name="Theme.Vxin" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 启动画面主题(API 30 及以下用 windowBackground 显示 splash) -->
    <style name="LaunchTheme" parent="Theme.Vxin">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>
</resources>
