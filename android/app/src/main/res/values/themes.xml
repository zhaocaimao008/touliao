<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose 应用使用无 ActionBar 主题；具体配色在 Compose Theme 中定义 -->
    <style name="Theme.Touliao" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 启动屏：SplashScreen API，冷启动无白屏 -->
    <style name="Theme.Touliao.Splash" parent="Theme.SplashScreen">
        <!-- 品牌启动页：深紫黑背景 + 居中新图标（带少量金色光晕），浅色/深色模式一致 -->
        <item name="windowSplashScreenBackground">#140A24</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <!-- 启动后切回主主题 -->
        <item name="postSplashScreenTheme">@style/Theme.Touliao</item>
    </style>

    <!-- 通话页（CallActivity）：窗口背景用通话底色，系统启动窗口和首帧之前都不闪白 -->
    <style name="Theme.Touliao.Call" parent="Theme.Touliao">
        <item name="android:windowBackground">@color/call_canvas</item>
    </style>
</resources>
